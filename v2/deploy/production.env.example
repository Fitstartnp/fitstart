# FitStart V2 production environment template for lunasants.com.
# Store actual values outside Git in a file readable only by the FitStart service identity.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=GENERATE_A_UNIQUE_RANDOM_SECRET_AND_STORE_OUTSIDE_GIT
DJANGO_ALLOWED_HOSTS=lunasants.com,www.lunasants.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://lunasants.com,https://www.lunasants.com
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=3600
FITSTART_PUBLIC_URL=https://lunasants.com

DB_NAME=fitstart
DB_USER=fitstart_app
DB_PASSWORD=GENERATE_A_UNIQUE_DATABASE_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432

# Configure a verified outbound SMTP service before enabling invitations/password recovery.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
