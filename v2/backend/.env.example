# Copy to a protected server-side environment file. Never commit the real file.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=development-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Leave DB_NAME empty for local SQLite development only.
# Production must use PostgreSQL and set all DB_* values.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=FitStart <no-reply@example.com>
